# LLM: set ONE key. If XAI_API_KEY is set it takes priority.
XAI_API_KEY=
OPENAI_API_KEY=
# Model id. Optional for OpenAI (defaults to gpt-4o-mini). REQUIRED when using XAI_API_KEY.
MIRROR_MODEL=

# Supabase (create a project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Required: /api/reflect uses it to check
# the login, enforce the free limit and save reflections.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed site (used for metadata)
NEXT_PUBLIC_SITE_URL=

# Stripe: one-time payment that unlocks unlimited reflections.
# Webhook endpoint: <site>/api/stripe-webhook, event checkout.session.completed
# (also checkout.session.async_payment_succeeded).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_UNLIMITED=
STRIPE_WEBHOOK_SECRET=
