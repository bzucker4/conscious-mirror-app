# LLM: set ONE key. If XAI_API_KEY is set it takes priority.
XAI_API_KEY=
OPENAI_API_KEY=
# Model id. Optional for OpenAI (defaults to gpt-4o-mini). REQUIRED when using XAI_API_KEY.
MIRROR_MODEL=

# Supabase (create a project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Required: /api/reflect uses it to check
# the login, enforce the free limit and save reflections.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed site (used for metadata)
NEXT_PUBLIC_SITE_URL=

# Stripe subscriptions: create two recurring Prices ($12/month, $79/year).
# Webhook endpoint: <site>/api/stripe-webhook, events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted.
# Also enable the Customer Portal in Stripe (Settings > Billing > Customer portal).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_WEBHOOK_SECRET=
